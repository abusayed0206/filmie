# Copy to .env.local. build.rs bakes these into the app at compile time.

# TMDB v3 API key: https://www.themoviedb.org/settings/api
TMDB=
# Trakt client ID (no secret needed): https://trakt.tv/oauth/applications
TRAKT=
# The redirect URI registered on your Trakt app. Token refresh must send it.
TRAKT_REDIRECT_URI=
