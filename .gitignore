# Keys baked in at compile time
.env.local

# Rust build output
target/

# Generated by tauri-build
src-tauri/gen/schemas/

# Generated by tauri android init; CI regenerates it.
src-tauri/gen/android/
# Written by scripts/android/build.ps1: the generated Gradle project runs its Rust step through npm here.
src-tauri/package.json

# Local Android APKs and UI screenshots
dist/
artifacts/

# Downloaded by scripts/fetch-ubol.ps1
src-tauri/extensions/

# Landing page
node_modules/
.cloudflare/
.wrangler/

# graphify output (regenerate with /graphify)
graphify-out/

# Local tool state and preview configs
.impeccable/
.claude/launch.json
