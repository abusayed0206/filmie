{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filmie",
  "version": "0.7.0-beta.2",
  "identifier": "app.filmie",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://image.tmdb.org data: blob:; frame-src https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.svg"],
    "resources": { "extensions/": "extensions/" }
  }
}
